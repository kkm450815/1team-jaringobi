# 모든 환경에서 사용하는 공개 URL — 메일/OAuth redirect 의 기준점.
# Capacitor 안드로이드 webview 는 window.location.origin 이 https://localhost
# 같은 무용지물 값이므로, redirectTo 는 항상 이 값을 쓰도록 강제한다.
VITE_PUBLIC_URL=https://1team-jaringobi.vercel.app

# Supabase — Vite 환경에서는 VITE_ 접두사여야 빌드 시 번들에 임베드됨.
# anon/publishable key 는 클라이언트에 노출 전제. RLS 가 데이터 보호.
VITE_SUPABASE_URL=https://ujgxjhjlorlkfkkzfldd.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_zTp5aQM2Ci-FhczMvnWJ6A_Xpx2War7
